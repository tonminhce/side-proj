<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>vn.vnpt</groupId>
    <artifactId>side-project</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>side-project</name>
    <description>Multi-module monorepo parent (see architecture.md §Project Structure &amp; Boundaries)</description>

    <!-- ponytail: BOMs (Spring Boot 4.0.0 + Spring Cloud 2025.1.0) intentionally NOT imported here.
         util/pom.xml owns them so every downstream service inherits transitively without duplication.
         See architecture-detail.md §Detail: ADR-01 line 97. -->

    <modules>
        <module>util</module>
        <!-- Services (14 + Story 3.4 gateway) -->
        <module>services/catalog</module>
        <module>services/inventory</module>
        <module>services/cart</module>
        <module>services/checkout</module>
        <module>services/payment</module>
        <module>services/gateway</module>
        <module>services/order</module>
        <module>services/fulfillment</module>
        <module>services/returns</module>
        <module>services/customer</module>
        <module>services/auth</module>
        <module>services/pricing</module>
        <module>services/search</module>
        <module>services/notification</module>
        <module>services/admin</module>
        <module>services/invoice</module>
        <!-- BFFs (2) -->
        <module>bff/storefront-bff</module>
        <module>bff/admin-bff</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <spring-boot.version>4.0.0</spring-boot.version>
        <spring-cloud.version>2025.1.0</spring-cloud.version>
        <spring-modulith.version>2.0.7</spring-modulith.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.14.1</version>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>4.0.0</version>
                </plugin>
                <!--
                  Spotless — pinned exactly per Story 0.4 / addendum A4 R-09 (Boot 4 ecosystem lag).
                  Plugin version policy matches the existing maven-compiler-plugin:3.14.1 line.
                  Story 0.4 nominally specified 2.46.0, but 3.8.0 is the current stable and is
                  compatible with both JDK 25 (CI) and JDK 26 (local dev). Without this bump
                  googleJavaFormat fails on JDK 26 with NoSuchMethodError against javac internals.
                  Configuration lives in util/pom.xml; Epic 1+ services inherit the plugin version
                  via pluginManagement.
                -->
                <plugin>
                    <groupId>com.diffplug.spotless</groupId>
                    <artifactId>spotless-maven-plugin</artifactId>
                    <version>3.8.0</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <dependencyManagement>
        <dependencies>
            <!--
              Spring Boot BOM / Spring Cloud BOM live at the ROOT pom because Maven
              dependencyManagement is non-transitive — services that depend on util do
              NOT inherit util's dependencyManagement. util/pom.xml re-imports the same
              BOMs for its own direct Spring Boot starter deps; service modules pick up
              the versions from this root block. See architecture-detail.md line 97.
            -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!--
              ArchUnit — pinned exactly per Story 0.4 / addendum A4 R-09 (Boot 4 ecosystem lag).
              Static analyzer with no Spring runtime dependency, so Boot 4 has no impact.
              Used by util/ archunit tests to enforce Spring Modulith package boundaries.
            -->
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>1.4.1</version>
                <scope>test</scope>
            </dependency>
            <!--
              Spring Modulith — pinned at root so services (e.g. services/catalog) inherit
              a single source of truth. Not in the Spring Boot BOM. Story 1.1 first consumer.
            -->
            <dependency>
                <groupId>org.springframework.modulith</groupId>
                <artifactId>spring-modulith-starter-core</artifactId>
                <version>${spring-modulith.version}</version>
            </dependency>
            <!--
              Spring Modulith events-jdbc — outbox bridge (Story 1.3 / ADR-01 / ADR-14).
              Bundles the @ApplicationModuleListener annotation processor and the
              JdbcOutboxChannel poller. Same version as starter-core; not in Boot BOM.
            -->
            <dependency>
                <groupId>org.springframework.modulith</groupId>
                <artifactId>spring-modulith-events-jdbc</artifactId>
                <version>${spring-modulith.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>