# dev/.env.example — Story 0.3
# Copy to dev/.env and edit if you need to change dev-only defaults.
# dev/.env is gitignored (see dev/.gitignore). NEVER commit real secrets here.

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app

# Per-service databases (Story 1.1: catalog; Story 1.5: inventory; Story 2.1: cart; Story 2.3: checkout).
POSTGRES_CATALOG_DB=catalog_db
POSTGRES_CATALOG_USER=catalog_user
POSTGRES_CATALOG_PASSWORD=catalog_pass
POSTGRES_INVENTORY_DB=inventory_db
POSTGRES_INVENTORY_USER=inventory_user
POSTGRES_INVENTORY_PASSWORD=inventory_pass
POSTGRES_CART_DB=cart_db
POSTGRES_CART_USER=cart_user
POSTGRES_CART_PASSWORD=cart_pass
POSTGRES_CHECKOUT_DB=checkout_db
POSTGRES_CHECKOUT_USER=checkout_user
POSTGRES_CHECKOUT_PASSWORD=checkout_pass

# Kafka (KRaft)
KAFKA_CLUSTER_ID=ecommerce-platform-cluster

# Redis (dev-only, no password)
REDIS_PASSWORD=

# MinIO (dev-only)
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123

# admin-bff (Story 1.4)
ADMIN_BFF_PORT=8082
CATALOG_SERVICE_URL=http://localhost:8081
NEXT_PUBLIC_OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# Story 1.6 — reservation TTL + sweeper
INVENTORY_RESERVATION_TTL_MINUTES=15
INVENTORY_RESERVATION_SWEEPER_INTERVAL_MS=30000
INVENTORY_RESERVATION_SWEEPER_BATCH_SIZE=100
INVENTORY_EVENTS_HMAC_SECRET=dev-only-secret-do-not-use-in-prod

# Story 2.3 — checkout HMAC secret for checkout.started events
CHECKOUT_EVENTS_HMAC_SECRET=dev-only-secret-do-not-use-in-prod

# Story 2.4 — Stripe API key (TEST MODE only — prod overrides via Vault at secret/stripe/<profile>
# per ADR-18). Do NOT commit a live key.
STRIPE_API_KEY=sk_test_dev-placeholder-do-not-use-in-prod
CHECKOUT_STRIPE_CURRENCY_DEFAULT=VND
