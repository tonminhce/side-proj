# dev/.env.example — Story 0.3
# Copy to dev/.env and edit if you need to change dev-only defaults.
# dev/.env is gitignored (see dev/.gitignore). NEVER commit real secrets here.

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app

# Per-service databases (Story 1.1: catalog). Each service bootstrap story adds its own triple.
POSTGRES_CATALOG_DB=catalog_db
POSTGRES_CATALOG_USER=catalog_user
POSTGRES_CATALOG_PASSWORD=catalog_pass

# Kafka (KRaft)
KAFKA_CLUSTER_ID=ecommerce-platform-cluster

# Redis (dev-only, no password)
REDIS_PASSWORD=

# MinIO (dev-only)
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123

# admin-bff (Story 1.4)
ADMIN_BFF_PORT=8082
CATALOG_SERVICE_URL=http://localhost:8081
NEXT_PUBLIC_OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
