<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>vn.vnpt</groupId>
        <artifactId>side-project</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>inventory</artifactId>
    <packaging>jar</packaging>

    <name>inventory</name>
    <description>InventoryService — per-warehouse ledger + sum-derivation on_hand (ADR-01, ADR-03, ADR-12, ADR-14)</description>

    <dependencies>
        <!--
          util: brings BOMs (Spring Boot 4.0.0, Spring Cloud 2025.1.0) transitively.
          All Spring Boot starter versions below inherit from util/pom.xml <dependencyManagement>.
          Do NOT re-import the BOMs here — architecture-detail.md line 97.
        -->
        <dependency>
            <groupId>vn.vnpt</groupId>
            <artifactId>util</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>

        <!-- Web: needed so @SpringBootApplication produces a runnable jar with embedded Tomcat.
             Story 1.8+ may add @RestControllers for inventory read APIs. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- JPA: needed for Warehouse + InventoryLedgerEntry entities. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Flyway: schema authority. Spring Boot 4 split Flyway autoconfig into its own
             module; spring-boot-flyway wires FlywayAutoConfiguration. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Postgres JDBC driver (runtime). -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Actuator: AC #22 /actuator/health endpoint. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Spring Modulith: enables @ApplicationModule on InventoryApplication.java. -->
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-core</artifactId>
        </dependency>

        <!--
          Modulith outbox bridge — Story 1.5 (ADR-01 / ADR-14 / ADR-20).
          Brings in @ApplicationModuleListener (in-process) and JdbcOutboxChannel
          (Kafka publish via the bridge's poller; deferred).
          Version inherited from root pom.xml <spring-modulith.version> (2.0.7).

          ponytail: we depend on services/catalog at compile scope so the
          CatalogProductCreated Avro-generated event is on the classpath for
          CatalogEventListener. Cross-service port sharing would require a
          shared events module; that's YAGNI for Story 1.5.
        -->
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-events-jdbc</artifactId>
        </dependency>

        <!--
          Story 1.5 / AC #14 — CatalogEventListener imports catalog's
          CatalogProductCreated Avro-generated event class. Per architecture.md
          line 879-884, events are cross-service contracts (entities are not).
          Version inherited from root reactor (1.0-SNAPSHOT).
        -->
        <dependency>
            <groupId>vn.vnpt</groupId>
            <artifactId>catalog</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Test scope -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ArchUnit: package-boundary test (Task 11). Version inherited from root pom.xml dependencyManagement. -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Testcontainers: prefer over H2 (AC #11). Pinned to 1.20.4. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <version>1.20.4</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>1.20.4</version>
            <scope>test</scope>
        </dependency>

        <!--
          ponytail: util/pom.xml declares Lombok as <optional>true</optional>, so it does NOT
          propagate transitively to consumers. Story 1.5 is the first inventory entity that uses
          Lombok annotations — declare Lombok directly here. Version matches util's.
        -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.42</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.1</version>
                <configuration>
                    <release>25</release>
                    <!-- -parameters: needed so @RequestParam / @PathVariable can resolve arg names
                         at runtime (without it Spring throws "Name for argument of type [int] not
                         specified" and rejects the request with 400). compilerArgs is the canonical
                         path for JDK 25 + release mode; <parameters>true</parameters> is silently
                         ignored in some maven-compiler-plugin 3.14.x builds. -->
                    <compilerArgs>
                        <arg>-parameters</arg>
                    </compilerArgs>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>1.18.42</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>4.0.0</version>
                <!-- Story 1.5: NO <skip>true</skip> — spring-boot:run must work. -->
            </plugin>
        </plugins>
    </build>
</project>