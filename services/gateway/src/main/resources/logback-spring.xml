<?xml version="1.0" encoding="UTF-8"?>
<!--
  logback-spring.xml — Story 3.4 (gateway) + Epic 4 MEDIUM sweep (deferred-issues.md Story 3.4).

  Re-wires the shared PanRedactingAppender (defined in util/src/main/resources/logback-include.xml)
  as the root console appender for the gateway service. Story 3.4 originally skipped this with
  a local STDOUT appender because util was not a dep; the Epic 4 sweep re-adds util as a compile
  dep and switches back to the shared redactor for R-15 "across all services" consistency.

  Defense-in-depth: the gateway never sees PAN-shaped fields today (only X-Card-Bin + X-Card-Last4,
  hashed to fingerprint before any log line could carry them), but the redaction is wired so a
  future story that adds debug logging cannot accidentally regress R-15.
-->
<configuration>
    <include resource="logback-include.xml"/>

    <root level="INFO">
        <appender-ref ref="REDACTING_CONSOLE"/>
    </root>
</configuration>
